# EvalForge Environment Configuration

# Service Settings
PROJECT_NAME="EvalForge"
ENVIRONMENT="development"
DEBUG=true
DEMO_MODE=true

# Security
SECRET_KEY="evalforge_super_secure_secret_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default SQLite for zero-config local run:
DATABASE_URL="sqlite:///./evalforge.db"
# Or PostgreSQL in production/docker:
# DATABASE_URL="postgresql://evalforge:evalforge_password@localhost:5432/evalforge_db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"
ENABLE_INLINE_WORKER=true

# Provider API Keys (Optional - Can also be configured securely in UI)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Frontend URL
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"
